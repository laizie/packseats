# Copy to .env (gitignored) and fill in. Any channel left blank is skipped;
# with no channels configured, notifications just print to stdout.
#
# You only need ONE channel. Telegram is the recommended default: it's free,
# takes two minutes to set up, and one bot can serve unlimited people if you
# ever share this. Pushover is an optional alternative (see below).

# --- Telegram (recommended) ---------------------------------------------------
# 1. Message @BotFather, send /newbot, and copy the token it gives you.
# 2. Message your new bot once (say anything), then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy the numeric
#    "chat":{"id": ...} value.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Pushover (optional alternative) ------------------------------------------
# Requires a Pushover account (one-time ~$5 license per platform). Its upside is
# emergency priority: PUSHOVER_PRIORITY=2 re-alerts every 60s for an hour until
# you acknowledge, and bypasses Do Not Disturb — handy during peak registration.
# User key is on your dashboard at https://pushover.net; create an app at
# https://pushover.net/apps/build to get the app token.
PUSHOVER_TOKEN=
PUSHOVER_USER=
# 1 = high priority; 2 = emergency (re-alerts until acknowledged, bypasses DND)
PUSHOVER_PRIORITY=1

# --- Shared friends bot (optional) --------------------------------------------
# Lets friends manage their own watches by messaging your Telegram bot — they set
# up nothing. Reuses TELEGRAM_BOT_TOKEN above (the same bot both receives commands
# and sends alerts). Leave the invite code blank to keep the bot closed to new
# users. See SECURITY.md for the safety model, then: systemctl enable --now packseats-bot
#
# Anyone with this code can join, so treat it like a password and hand it out
# only to people you want using your instance ("with my permission").
PACKSEATS_INVITE_CODE=
# Your own Telegram chat id — you're auto-approved as admin (/users, /kick) and get
# pinged when someone joins. Defaults to TELEGRAM_CHAT_ID above if left blank.
PACKSEATS_ADMIN_CHAT_ID=
# Max watches per user, to bound how much catalog polling your instance takes on.
PACKSEATS_MAX_WATCHES=15

# --- Web planner for friends (optional) ---------------------------------------
# Lets friends open the visual planner UI by sending /ui to the bot. Both the bot
# and the planner must share PACKSEATS_SECRET (it signs login links + sessions).
# Generate one with:  openssl rand -hex 32
# Leaving it blank keeps the planner single-user/localhost (no friend logins).
PACKSEATS_SECRET=
# The public HTTPS address friends reach the planner at, e.g. https://you.duckdns.org
# (served by Caddy in front of the localhost Flask app — see SECURITY.md). Required
# to expose the planner; the app refuses to bind a public interface without a secret.
PACKSEATS_PUBLIC_URL=
