# Copy to .env (gitignored) and fill in. Any channel left blank is skipped;
# with no channels configured, notifications print to stdout.

# Telegram: create a bot with @BotFather to get the token. Then message your bot
# once and visit https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pushover: user key is on your dashboard at https://pushover.net;
# create an app at https://pushover.net/apps/build to get the app token.
PUSHOVER_TOKEN=
PUSHOVER_USER=
# 1 = high priority; 2 = emergency (re-alerts until acknowledged, bypasses DND)
PUSHOVER_PRIORITY=1
